<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/testMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_animated_sunset"
    android:padding="24dp">

    <Button
        android:id="@+id/testMenuBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="← 메인 화면"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC161824"
        app:strokeWidth="3dp"
        app:strokeColor="#4DFFFFFF"
        app:cornerRadius="24dp" />

    <Button
        android:id="@+id/fallTestButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="낙상 감지 테스트"
        android:layout_marginTop="12dp"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC161824"
        app:strokeWidth="3dp"
        app:strokeColor="#4DFFFFFF"
        app:cornerRadius="32dp" />

    <Button
        android:id="@+id/fallCallTestButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:text="낙상 감지 및 보호자 연결 테스트"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC161824"
        app:strokeWidth="3dp"
        app:strokeColor="#4DFFFFFF"
        app:cornerRadius="32dp" />

    <Button
        android:id="@+id/rhythmTestButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:text="리듬게임 테스트"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC161824"
        app:strokeWidth="3dp"
        app:strokeColor="#4DFFFFFF"
        app:cornerRadius="32dp" />
</LinearLayout>
